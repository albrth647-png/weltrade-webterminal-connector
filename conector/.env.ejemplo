# Credenciales de tu cuenta (usa la DEMO para pruebas)
WT_LOGIN=tu_numero_de_cuenta
WT_PASS=tu_contraseña_aqui

# Servidor: demo o real
WT_HOST=mt5.demo.weltrade.org

# (Opcional) filtra símbolos separados por coma; vacío = todos los sintéticos
# WT_SYMBOLS=FX Vol 20,SFX Vol 40

# Formato de salida: json (para programas) o texto (para leer)
WT_FORMAT=json
