# ========= Motor de Señales — configuración =========
# Copia este archivo a .env y rellena tus credenciales.
# .env está en .gitignore: NUNCA se sube al repositorio.

# --- Cuenta MT5 Weltrade (igual que el conector) ---
WT_LOGIN=tu_numero_de_cuenta
WT_PASS=tu_contraseña
WT_HOST=mt5.demo.weltrade.org
# WT_HOST=mt5.real.weltrade.org   # cuenta real (bajo tu responsabilidad)

# --- Motor ---
# Símbolos separados por coma (vacío = todos los sintéticos del catálogo).
# Nota: si el documento de estrategia trae "simbolos", ese manda.
# MS_SIMBOLOS=FX Vol 20,FX Vol 40,SFX Vol 20,Step Index
# La ESTRATEGIA (score mínimo, dedup, pesos, TFs, SL/TP...) NO se
# configura por .env: vive en documentos de estrategia y se cambia
# desde el panel web http://localhost:3000/ (botón "Importar documento").
# 1 = silencia Telegram para pruebas
# MS_SIN_TELEGRAM=1
# 1 = registra zonas/toques en consola
# MS_VERBOSO=1
# --- carril urgente: alarma instantánea (no depende de Telegram ni de FCM) ---
# ntfy: publica en un tema y el móvil lo recibe en menos de un segundo con la
# app de ntfy (versión F-Droid, que NO usa Firebase). Elige un tema privado.
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=cambia-esto-por-un-tema-privado
# NTFY_TOKEN=            (solo si el tema es privado con token)
# Alarma local en el PC: pitido en la consola. MS_ALARMA=0 la apaga.
# MS_ALARMA_CMD=mpv /ruta/alarma.mp3        (opcional: sonido propio)
# --- qué se envía al móvil ---
# MS_TF_VIVO=M5          (temporalidades que salen; M5,M15 para ampliar)
# MS_AVISO_INTRABAR=0    (apaga «nivel en juego»; va encendido)
# MS_SEDUCTORA=0 apaga la seductora (1S). Va encendida: es parte del catálogo.
# Los TOQUES 1/2/3 (avisos, no entradas) van a Telegram POR DEFECTO:
# el móvil recibe 1/2/3 (toque), 1R/2R/3R (rompimiento).
# MS_TELEGRAM_TOQUES=0 los silencia (o MS_TELEGRAM_AVISOS=0, nombre viejo).

# --- Telegram (opcional, recomendado) ---
# 1) Habla con @BotFather -> /newbot -> copia el token
# 2) Escríbele a tu bot un mensaje cualquiera
# 3) Saca tu chat id: https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_TOKEN=123456:ABC...
# TELEGRAM_CHAT=123456789

# --- Servidor HTTP (Render usa su propio PORT) ---
PORT=3000
